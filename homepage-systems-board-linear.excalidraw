   "versionNonce": 607151283,
   "updated": 1789643193278,
   "text": "Alkemio has no orientation system \u2014 only a page.",
   "originalText": "Alkemio has no orientation system \u2014 only a page.",
   "fontSize": 30,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
