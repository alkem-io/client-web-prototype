   "versionNonce": 450047120,
   "updated": 1789643193278,
   "text": "\u00b7 Not a layout problem \u2014 rearranging these blocks changes nothing.\n\u00b7 Not a copy problem \u2014 more explanation is the thing we're trying to avoid.\n\u00b7 Not where the Create-a-Space button sits.\n\u00b7 Mostly not the returning signed-in user \u2014 chrome already serves them.",
   "originalText": "\u00b7 Not a layout problem \u2014 rearranging these blocks changes nothing.\n\u00b7 Not a copy problem \u2014 more explanation is the thing we're trying to avoid.\n\u00b7 Not where the Create-a-Space button sits.\n\u00b7 Mostly not the returning signed-in user \u2014 chrome already serves them.",
   "fontSize": 13,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
