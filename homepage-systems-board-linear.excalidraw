   "roundness": null,
   "seed": 1017594730,
   "isDeleted": false,
   "boundElements": null,
   "link": null,
   "locked": false,
   "version": 1,
   "versionNonce": 66423868,
   "updated": 1789643193278,
   "text": "Symptom: people new(ish) to the platform get lost.   \u00b7   Root cause: the question they arrive with and the answer\nthe page is able to give are different kinds of thing.",
   "originalText": "Symptom: people new(ish) to the platform get lost.   \u00b7   Root cause: the question they arrive with and the answer\nthe page is able to give are different kinds of thing.",
