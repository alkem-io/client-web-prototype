   "boundElements": null,
   "link": null,
   "locked": false,
   "version": 1,
   "versionNonce": 677129422,
   "updated": 1789643193278,
   "text": "So home is asked to answer \u201cis this for me?\u201d and \u201cwhat should I do first?\u201d \u2014\nand the only vocabulary it has is a list of spaces.",
   "originalText": "So home is asked to answer \u201cis this for me?\u201d and \u201cwhat should I do first?\u201d \u2014\nand the only vocabulary it has is a list of spaces.",
   "fontSize": 19,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e164100510283445",
   "type": "text",
   "x": 26,
   "y": 276,
   "width": 763.88,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#5c5f66",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
