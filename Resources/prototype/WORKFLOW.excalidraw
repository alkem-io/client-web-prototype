      "versionNonce": 979196760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE LIST FOR THE DEVELOPERS     src/ahead\n\nThings we made that they don't have yet \u2014 and that\nthey should eventually own. This is the list you\nhand them. That is its whole job.\n\nSomething goes IN when it's new, reusable, and\nthe dev team will want it one day.\n\nSomething LEAVES when they build it: ours gets\ndeleted and theirs is used instead.",
      "originalText": "THE LIST FOR THE DEVELOPERS     src/ahead\n\nThings we made that they don't have yet \u2014 and that\nthey should eventually own. This is the list you\nhand them. That is its whole job.\n\nSomething goes IN when it's new, reusable, and\nthe dev team will want it one day.\n\nSomething LEAVES when they build it: ours gets\ndeleted and theirs is used instead.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-335924454",
      "lineHeight": 1.25,
      "autoResize": true
    },
