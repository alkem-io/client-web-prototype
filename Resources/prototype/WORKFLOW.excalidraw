    },
    {
      "id": "text-351774312",
      "type": "text",
      "x": 1584.6,
      "y": 161.875,
      "width": 310.8,
      "height": 206.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
