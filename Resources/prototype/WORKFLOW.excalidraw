      "roundness": null,
      "seed": 228300107,
      "version": 1,
      "versionNonce": 386054364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHAT THE SYNC TELLS YOU\n\nAt the end of step 2 you get a list:\n\n[  ]   still only ours\n[ ~ ]  production started building it\n[ ! ]  production HAS it now\n\nA  [ ! ]  means we're maintaining\nsomething twice. That's the one\nto act on.",
      "originalText": "WHAT THE SYNC TELLS YOU\n\nAt the end of step 2 you get a list:\n\n[  ]   still only ours\n[ ~ ]  production started building it\n[ ! ]  production HAS it now\n\nA  [ ! ]  means we're maintaining\nsomething twice. That's the one\nto act on.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-719397037",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "rectangle-902418915",
      "type": "rectangle",
