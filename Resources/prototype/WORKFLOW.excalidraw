      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "But once they catch up and build the same thing themselves, there are suddenly two of everything \u2014",
      "originalText": "But once they catch up and build the same thing themselves, there are suddenly two of everything \u2014",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
