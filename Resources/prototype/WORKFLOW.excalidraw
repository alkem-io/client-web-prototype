      "locked": false,
      "text": "Every \"keep ours\" and every \"design it fresh\" is a thing we now maintain twice over.",
      "originalText": "Every \"keep ours\" and every \"design it fresh\" is a thing we now maintain twice over.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-746102311",
      "type": "text",
      "x": 920,
      "y": 1025,
      "width": 932.4000000000001,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 749591003,
      "version": 1,
      "versionNonce": 112534383,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "That's fine \u2014 it's the point of the prototype. It just has to be written down, which is what src/ahead/ is for.",
      "originalText": "That's fine \u2014 it's the point of the prototype. It just has to be written down, which is what src/ahead/ is for.",
      "fontSize": 15,
      "fontFamily": 5,
