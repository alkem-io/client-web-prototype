      "versionNonce": 372094428,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022   For them, it's the list of what to build next \u2014 already designed, already working.",
      "originalText": "\u2022   For them, it's the list of what to build next \u2014 already designed, already working.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
