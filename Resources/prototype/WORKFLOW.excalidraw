      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The prototype is meant to run ahead of what the developers have built. That's the whole point of it.",
      "originalText": "The prototype is meant to run ahead of what the developers have built. That's the whole point of it.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
