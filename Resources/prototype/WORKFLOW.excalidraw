      "groupIds": [],
      "frameId": null,
      "index": "bLr",
      "roundness": null,
      "seed": 2074396096,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "\"That's not mess \u2014 that's the undo trail. It's what lets us\ngo back to \"the one before you changed the card layout\"\ninstead of guessing.\" - Claude on committing each time the\nai adjsuts something",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
