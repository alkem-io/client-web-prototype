      "roundness": null,
      "seed": 325150805,
      "version": 1,
      "versionNonce": 677020470,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE ONE RULE\n\nNever edit  src/crd/\nThat folder is production's.\nEverything else is yours.",
      "originalText": "THE ONE RULE\n\nNever edit  src/crd/\nThat folder is production's.\nEverything else is yours.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-350986834",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "rectangle-248232744",
      "type": "rectangle",
      "x": 1900,
      "y": 150,
      "width": 440,
      "height": 330,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 329288203,
      "version": 1,
      "versionNonce": 124614529,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "text-761920263"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text-761920263",
      "type": "text",
      "x": 1960.4,
      "y": 183.75,
      "width": 319.20000000000005,
      "height": 262.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 756842382,
      "version": 1,
      "versionNonce": 468237636,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE THREE WORDS\n\nCOMMIT  \u2014  save a snapshot with a note\nsaying what changed. Stays on your\nmachine. Do it often.\n\nPUSH  \u2014  send those commits to GitHub.\nNow they're not only on your laptop,\nand others can open the branch.\nmain is still untouched.\n\nMERGE  \u2014  fold your branch into main.\nThe only one that changes what\neveryone else gets.",
      "originalText": "THE THREE WORDS\n\nCOMMIT  \u2014  save a snapshot with a note\nsaying what changed. Stays on your\nmachine. Do it often.\n\nPUSH  \u2014  send those commits to GitHub.\nNow they're not only on your laptop,\nand others can open the branch.\nmain is still untouched.\n\nMERGE  \u2014  fold your branch into main.\nThe only one that changes what\neveryone else gets.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-248232744",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "rectangle-104761702",
      "type": "rectangle",
      "x": 1900,
      "y": 520,
      "width": 440,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 639154257,
      "version": 1,
      "versionNonce": 410246876,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
