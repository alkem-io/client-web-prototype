      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022   For us, it's the thing that gets checked every time they ship something new.",
      "originalText": "\u2022   For us, it's the thing that gets checked every time they ship something new.",
      "fontSize": 17,
      "fontFamily": 5,
