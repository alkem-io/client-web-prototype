      "versionNonce": 399377607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "So:  anything we make that they don't have goes in  src/ahead.",
      "originalText": "So:  anything we make that they don't have goes in  src/ahead.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
