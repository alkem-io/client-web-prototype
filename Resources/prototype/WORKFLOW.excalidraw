    },
    {
      "id": "3zEBm4J6IeUkqVo9R-wtn",
      "type": "text",
      "x": -12770.224119961847,
      "y": 3292.2211998206685,
      "width": 345.8556213378906,
      "height": 70,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1529296320,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "Every catch-up also compares this list against what\nclient-web has shipped, and names anything now built\nthere. That naming is the signal to clear it \u2014 without\nit, nobody would notice.",
      "originalText": "Every catch-up also compares this list against what\nclient-web has shipped, and names anything now built\nthere. That naming is the signal to clear it \u2014 without\nit, nobody would notice.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bLp",
      "version": 4984,
      "versionNonce": 1830596160,
      "updated": 1791207875763
    },
    {
      "id": "6pfZiK-gr1nsbz0A56U1R",
      "type": "text",
      "x": -12770.224119961847,
      "y": 3392.2211998206685,
      "width": 440.3134765625,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1681554880,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "The catch-up is when the AI fetches client-web's latest finished work.\nIt is part of step 1 at the top of this board, and it is the only part\nof any of this that happens without being asked.",
      "originalText": "The catch-up is when the AI fetches client-web's latest finished work.\nIt is part of step 1 at the top of this board, and it is the only part\nof any of this that happens without being asked.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bLq",
      "version": 4985,
      "versionNonce": 2045568576,
      "updated": 1791207875765
    },
    {
      "id": "AsEE1lQrS6EfS_uipNv5g",
