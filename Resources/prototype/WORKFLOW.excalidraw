      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE DEVELOPERS' SHELF           src/crd\n\nEvery finished piece the dev team has built and\nshipped \u2014 buttons, cards, dialogs, whole screens.\n\nNobody edits this. Not you, not Claude. Ever.\n\nIt changes at exactly one moment: step 2.",
      "originalText": "THE DEVELOPERS' SHELF           src/crd\n\nEvery finished piece the dev team has built and\nshipped \u2014 buttons, cards, dialogs, whole screens.\n\nNobody edits this. Not you, not Claude. Ever.\n\nIt changes at exactly one moment: step 2.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-545600047",
      "lineHeight": 1.25,
      "autoResize": true
    },
