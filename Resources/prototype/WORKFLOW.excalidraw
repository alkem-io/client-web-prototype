      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE ONE QUESTION\nYOU'LL BE ASKED\n\n\"The developers have built this\none too \u2014 use theirs, or keep ours?\"\n\nKeep ours only when somebody\ndesigned it that way on purpose.\n\nOtherwise take theirs. It's one\nless thing for us to look after.",
      "originalText": "THE ONE QUESTION\nYOU'LL BE ASKED\n\n\"The developers have built this\none too \u2014 use theirs, or keep ours?\"\n\nKeep ours only when somebody\ndesigned it that way on purpose.\n\nOtherwise take theirs. It's one\nless thing for us to look after.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-727027240",
      "lineHeight": 1.25,
      "autoResize": true
    },
