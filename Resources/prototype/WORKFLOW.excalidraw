    },
    {
      "id": "text-817903762",
      "type": "text",
      "x": 1597.2,
      "y": 465.625,
      "width": 285.6,
      "height": 168.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 407711156,
      "version": 1,
      "versionNonce": 168250142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "BRANCH HABITS\n\n1.  Never build on main.\n2.  One branch per ticket.\n3.  Name it so you recognise it\n     later \u2014 not \"test2\".\n4.  Days, not weeks. The longer it\n     lives, the harder it merges.\n5.  Merge it, then delete it.",
      "originalText": "BRANCH HABITS\n\n1.  Never build on main.\n2.  One branch per ticket.\n3.  Name it so you recognise it\n     later \u2014 not \"test2\".\n4.  Days, not weeks. The longer it\n     lives, the harder it merges.\n5.  Merge it, then delete it.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-902418915",
      "lineHeight": 1.25,
      "autoResize": true
    },
