      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "OUR SCREENS                     src/app\n\nThe prototype's own pages. Most work lands here,\nand it's built from the developers' shelf\nwherever there's something that fits.",
      "originalText": "OUR SCREENS                     src/app\n\nThe prototype's own pages. Most work lands here,\nand it's built from the developers' shelf\nwherever there's something that fits.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rectangle-227187026",
      "lineHeight": 1.25,
      "autoResize": true
    },
