        }
      ],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text-620397065",
      "type": "text",
      "x": 1943.6,
      "y": 546.875,
      "width": 352.8,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 443243411,
      "version": 1,
      "versionNonce": 944619638,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Like a document:  commit = save a version.\npush = put it on the shared drive.\nmerge = make it the official one.",
      "originalText": "Like a document:  commit = save a version.\npush = put it on the shared drive.\nmerge = make it the official one.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-104761702",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "rectangle-169562586",
