      "versionNonce": 591744191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The prototype is meant to run ahead of what the developers have built. That's the whole point of it.",
      "originalText": "The prototype is meant to run ahead of what the developers have built. That's the whole point of it.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-717435053",
      "type": "text",
      "x": 40,
      "y": 1580,
      "width": 987.8400000000001,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 595883436,
      "version": 1,
      "versionNonce": 251178813,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "But once they catch up and build the same thing themselves, there are suddenly two of everything \u2014",
      "originalText": "But once they catch up and build the same thing themselves, there are suddenly two of everything \u2014",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-723327123",
      "type": "text",
      "x": 40,
      "y": 1610,
      "width": 554.4000000000001,
      "height": 22.5,
